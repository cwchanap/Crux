+def pair_emitted_frame_confidence(emitted_frames, onset_probs, min_pitch):
+  """Pair captured emission metadata with its selected onset activation."""
+  paired = []
+  for start_frame, native_midi_note, raw_velocity in emitted_frames:
+    pitch = native_midi_note - min_pitch
+    paired.append((
